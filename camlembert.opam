# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Terminal user interfaces for OCaml, ported from Rust's Ratatui"
description:
  "Camlembert is an immediate-mode terminal UI library. Widgets draw into a cell buffer, the buffer is diffed against the previous frame, and only the changed cells are sent to a backend."
maintainer: ["André Borba <andre.borbaaf2b@gmail.com>"]
authors: ["André Borba <andre.borbaaf2b@gmail.com>"]
license: "MIT"
tags: ["tui" "terminal" "ui" "ratatui"]
homepage: "https://github.com/AF2B/camlembert"
bug-reports: "https://github.com/AF2B/camlembert/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "uucp"
  "uuseg"
  "alcotest" {with-test & >= "1.6"}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/AF2B/camlembert.git"
